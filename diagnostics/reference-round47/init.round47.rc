# Mirror LoadBootScripts' default paths when ro.boot.init_rc overrides its entry.
import /metadata/bootdiag/init.staged-round47.rc
import /system/etc/init
import /system_ext/etc/init
import /vendor/etc/init
import /odm/etc/init
import /product/etc/init

on early-init
    write /proc/sys/kernel/printk_devkmsg on
    mount none /metadata/bootdiag/vendor-modprobe.round47.sh /vendor/bin/vendor_modprobe.sh bind
    write /sys/devices/system/cpu/cpu0/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu1/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu2/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu3/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu4/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu5/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu6/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu7/cpuidle/state1/disable 1
    mount none /metadata/bootdiag/modules.blocklist.round47 /vendor_dlkm/lib/modules/modules.blocklist bind
    start bootdiag_kmsg
    start bootdiag_watch
    start bootdiag_deadline

on init
    start bootdiag_logcat

service bootdiag_kmsg /metadata/bootdiag/busybox sh /metadata/bootdiag/kmsg-wrapper.round47.sh
    shutdown critical
    disabled
    oneshot
    user root
    group root log readproc
    seclabel u:r:su:s0
    stdio_to_kmsg

service bootdiag_watch /metadata/bootdiag/busybox sh /metadata/bootdiag/watch.round47.sh
    disabled
    oneshot
    user root
    group root log readproc
    seclabel u:r:su:s0
    stdio_to_kmsg

service bootdiag_logcat /system/bin/logcat -b main -b system -b crash -b events -v threadtime -f /metadata/bootdiag/pixelos-round47-logcat.txt -r 512 -n 2 auditd:S logd:S kmsg:S audioadsprpcd:S DMABUFHEAPS:W *:V
    shutdown critical
    disabled
    user root
    group root log readproc
    seclabel u:r:su:s0
    stdio_to_kmsg

on early-init
    write /proc/sys/kernel/printk_ratelimit 0
    loglevel 7
    setprop sys.init_log_level 7

service bootdiag_prepare_adb /metadata/bootdiag/busybox sh /metadata/bootdiag/prepare-adb.round47.sh
    disabled
    oneshot
    user root
    group root log readproc
    seclabel u:r:su:s0
    stdio_to_kmsg

service bootdiag_early_checkpoint /metadata/bootdiag/busybox sh /metadata/bootdiag/checkpoint.round47.sh
    disabled
    oneshot
    user root
    group root log readproc
    seclabel u:r:su:s0
    stdio_to_kmsg

service bootdiag_deadline /metadata/bootdiag/busybox sh /metadata/bootdiag/bootdiag-deadline.round47
    disabled
    oneshot
    user root
    group root
    seclabel u:r:su:s0
    stdio_to_kmsg

on post-fs-data
    exec u:r:su:s0 root root -- /metadata/bootdiag/busybox sh /metadata/bootdiag/recover-adb-parent.round47.sh
    start bootdiag_early_checkpoint

on property:ro.persistent_properties.ready=true
    start bootdiag_prepare_adb

on property:sys.boot_completed=1
    stop bootdiag_deadline
    write /dev/kmsg "<4>BOOTDIAG_RUNTIME: boot_completed=1"

on shutdown
    write /dev/kmsg "<4>BOOTDIAG47: shutdown_trigger"
