<?xml version='1.0' encoding='utf-8'?>
<manifest>
  <!-- Device, kernel and vendor trees checked out from the m2381 split
       repositories instead of being copied in by rsync. With project entries
       here, `repo manifest -r` records their commits like any upstream
       project, and `repo status` shows their local changes.

       The remote hosts the split device repositories in meizu-m2381. -->
  <remote name="meizu-m2381"
          fetch="https://github.com/meizu-m2381" />

  <project path="device/meizu/m2381"
           name="android_device_meizu_m2381"
           remote="meizu-m2381"
           revision="main" />
  <project path="device/meizu/m2381-kernel"
           name="android_device_meizu_m2381-kernel"
           remote="meizu-m2381"
           revision="main" />
  <project path="vendor/meizu/m2381"
           name="proprietary_vendor_meizu_m2381"
           remote="meizu-m2381"
           revision="main" />
</manifest>
